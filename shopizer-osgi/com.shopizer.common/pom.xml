<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.shopizer</groupId>
        <artifactId>shopizer-osgi-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>com.shopizer.common</artifactId>
    <packaging>bundle</packaging>

    <name>Shopizer Common Module</name>
    <description>Shared entities, utilities, exceptions, and configuration</description>

    <dependencies>
        <!-- OSGI -->
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>osgi.core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>org.osgi.service.component.annotations</artifactId>
        </dependency>
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>org.osgi.service.component</artifactId>
        </dependency>

        <!-- Jakarta Persistence API -->
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
            <version>3.1.0</version>
        </dependency>

        <!-- JPA & Hibernate -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
        </dependency>

        <!-- Spring Data JPA -->
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-jpa</artifactId>
        </dependency>

        <!-- JWT -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
        </dependency>

        <!-- Jackson (needed for DTO JSON processing) -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
            <version>2.15.2</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
            <version>2.15.2</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.15.2</version>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- PostgreSQL JDBC Driver -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <configuration>
                    <instructions>
                        <Bundle-SymbolicName>com.shopizer.common</Bundle-SymbolicName>
                        <Bundle-Name>Shopizer Common Module</Bundle-Name>
                        <Bundle-Version>1.0.0</Bundle-Version>
                        <Bundle-Activator>com.shopizer.common.CommonActivator</Bundle-Activator>
                        <Export-Package>
                            com.shopizer.common.entity;-noimport:=true,
                            com.shopizer.common.exception;-noimport:=true,
                            com.shopizer.common.util;-noimport:=true,
                            com.shopizer.common.dto;-noimport:=true,
                            com.shopizer.common.config;-noimport:=true,
                            jakarta.persistence.*;-split-package:=merge-first,
                            org.hibernate.*;-split-package:=merge-first,
                            org.springframework.*;-split-package:=merge-first,
                            io.jsonwebtoken.*;-split-package:=merge-first,
                            org.postgresql.*;-split-package:=merge-first,
                            com.fasterxml.jackson.annotation.*;-split-package:=merge-first,
                            com.fasterxml.jackson.core.*;-split-package:=merge-first,
                            com.fasterxml.jackson.databind.*;-split-package:=merge-first
                        </Export-Package>
                        <Import-Package>
                            jakarta.persistence.*;resolution:=optional,
                            org.hibernate.*;resolution:=optional,
                            org.springframework.*;resolution:=optional,
                            io.jsonwebtoken.*;resolution:=optional,
                            org.postgresql.*;resolution:=optional,
                            org.slf4j;version="[2.0,3)",
                            org.osgi.framework;version="[1.8,2)",
                            org.osgi.service.component.annotations;version="[1.3,2)";resolution:=optional,
                            *;resolution:=optional
                        </Import-Package>
                        <Embed-Dependency>
                            hibernate-core,
                            spring-data-jpa,
                            jjwt-api,
                            jjwt-impl,
                            jjwt-jackson,
                            jakarta.persistence-api,
                            jackson-annotations,
                            jackson-core,
                            jackson-databind,
                            *;scope=compile|runtime;inline=false
                        </Embed-Dependency>
                        <Embed-Transitive>true</Embed-Transitive>
                        <Bundle-ClassPath>.,{maven-dependencies}</Bundle-ClassPath>
                    </instructions>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
