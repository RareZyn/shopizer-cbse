            height: 24px;
        }

        .rel-type {
            font-size: 0.75rem;
            color: #8892b0;
            text-align: center;
        }

        /* Stats Section */
        .stats-section {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-top: 50px;
            padding-top: 40px;
            border-top: 2px solid #233554;
        }

        .stat-card {
            background: linear-gradient(145deg, #1e2a4a, #1a2342);
            padding: 25px;
            border-radius: 12px;
            text-align: center;
            border: 1px solid #233554;
        }

        .stat-number {
            font-size: 2.5rem;
            font-weight: 700;
            background: linear-gradient(90deg, #00d4ff, #64ffda);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .stat-label {
            color: #8892b0;
            font-size: 0.9rem;
            margin-top: 5px;
        }

        /* Footer */
