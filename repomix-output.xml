            entityManager.clear();
        } catch (Exception e) {
            logger.error("Error clearing entity manager: {}", e.getMessage(), e);
        }
    }

    /**
     * Get EntityManager for advanced operations
     * Use sparingly - prefer repository methods
     */
    public EntityManager getEntityManager() {
        return entityManager;
    }
}
