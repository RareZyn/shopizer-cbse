            gap: 15px;
            flex-wrap: wrap;
        }

        .rel-table {
            padding: 10px 20px;
            background: #1a2342;
            border-radius: 8px;
            border: 1px solid #233554;
            font-size: 0.9rem;
            color: #ccd6f6;
