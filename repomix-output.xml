                        <Bundle-Name>${project.name}</Bundle-Name>
                        <Bundle-Version>${project.version}</Bundle-Version>
                        <Bundle-Activator>com.shopizer.rest.activator.RestActivator</Bundle-Activator>
                        <Export-Package>
