            entityManager.getTransaction().begin();
            for (Product product : entities) {
                if (product.getId() != null) {
                    entityManager.createQuery("DELETE FROM Product p WHERE p.id = :id")
                        .setParameter("id", product.getId())
                        .executeUpdate();
